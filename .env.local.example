# Copiază acest fișier ca .env.local (fără ".example") și completează valorile.
# .env.local e deja exclus din git — niciuna dintre valorile de mai jos nu
# ajunge vreodată într-un commit.

# Din Supabase → Project Settings → API Keys (proiectul "spocoi", Frankfurt).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secretă — NICIODATĂ cu prefix NEXT_PUBLIC_, NICIODATĂ trimisă către client.
# Folosită doar în server actions / route handlers.
SUPABASE_SECRET_KEY=

# Din console.anthropic.com — proiect/workspace separat "spocoi", NU cheia
# folosită de agentul de marketing. Folosită doar server-side (răspunsurile
# AI din /chat).
ANTHROPIC_API_KEY=

# Din resend.com/api-keys — folosită pentru emailul de confirmare la
# înscrierea pe waitlist. Necesită domeniul spocoi.com verificat în Resend.
RESEND_API_KEY=

# Adresa "From" a emailurilor de waitlist — trebuie să fie pe un domeniu
# verificat în Resend. Opțional, are un default în cod.
WAITLIST_FROM_EMAIL=
